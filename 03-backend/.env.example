# --- Database -----------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/sales_crm

# --- Security -----------------------------------------------------------------
# HMAC secret for JWT signing. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-with-openssl-rand-hex-32>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true behind HTTPS (production). Controls the Secure flag on the refresh cookie.
COOKIE_SECURE=false

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowlist of frontend origins.
CORS_ORIGINS=http://localhost:3000

# Chrome-extension origins allowed by CORS (comma-separated). Find the id in
# chrome://extensions after loading the unpacked extension. Only
# chrome-extension:// origins are accepted; anything else is ignored.
# Example: EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
EXTENSION_ORIGINS=

# Access-token TTL (hours) for the extension login flow (?client=extension).
# The extension gets no refresh cookie; it stores this token in
# chrome.storage.session and re-logs after expiry or browser restart.
EXTENSION_ACCESS_TOKEN_EXPIRE_HOURS=12

# --- Initial admin (used by `python -m app.db.seeds`) -------------------------
# Must be a real-format email (".local"/".test" TLDs are rejected at login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<set-a-strong-password>
ADMIN_NAME=Admin

# Name of the httpOnly refresh-token cookie.
REFRESH_COOKIE_NAME=crm_refresh_token

# --- Misc ---------------------------------------------------------------------
# dev | test | production
# In production the app REFUSES to start unless JWT_SECRET is a real secret
# (>= 32 chars, not the dev default) and COOKIE_SECURE=true.
ENVIRONMENT=dev

# --- Webhook hardening --------------------------------------------------------
# Max accepted webhook payload size in bytes (413-style 422 above this).
WEBHOOK_MAX_BODY_BYTES=10240
