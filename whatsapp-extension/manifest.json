{
  "manifest_version": 3,
  "name": "CRM Lead Capture",
  "description": "Captura de leads do WhatsApp Web direto para o CRM de Vendas",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CRM Lead Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
